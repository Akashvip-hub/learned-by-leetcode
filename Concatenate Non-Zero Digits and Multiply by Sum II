class Solution(object):
    def sumAndMultiply(self, s, queries):
        MOD = 10**9 + 7
        n = len(s)
        
        pref_val = [0] * (n + 1)
        pref_sum = [0] * (n + 1)
        nz_count = [0] * (n + 1)
        
        pow10 = [1] * (n + 1)
        for i in range(1, n + 1):
            pow10[i] = (pow10[i - 1] * 10) % MOD
            
        for i in range(n):
            d = int(s[i])
            if d != 0:
                pref_val[i + 1] = (pref_val[i] * 10 + d) % MOD
                nz_count[i + 1] = nz_count[i] + 1
            else:
                pref_val[i + 1] = pref_val[i]
                nz_count[i + 1] = nz_count[i]
            
            pref_sum[i + 1] = (pref_sum[i] + d) % MOD
            
        ans = []
        for l, r in queries:
            total_sum = (pref_sum[r + 1] - pref_sum[l] + MOD) % MOD
            
            nz_after_r = nz_count[n] - nz_count[r + 1]
            nz_after_l = nz_count[n] - nz_count[l]
            k = nz_after_l - nz_after_r
            
            if k == 0:
                ans.append(0)
                continue
                
            term1 = pref_val[r + 1]
            term2 = (pref_val[l] * pow10[k]) % MOD
            x = (term1 - term2 + MOD) % MOD
            ans.append((x * total_sum) % MOD)
            
        return ans
