class Solution(object):
    def minMoves(self, nums, limit):
        n = len(nums)
        diff = [0] * (2 * limit + 2)
        for i in range(n // 2):
            a, b = nums[i], nums[n - 1 - i]
            diff[2] += 2
            diff[2 * limit + 1] -= 2
            diff[min(a, b) + 1] -= 1
            diff[max(a, b) + limit + 1] += 1
            diff[a + b] -= 1
            diff[a + b + 1] += 1
            
        ans = n 
        current_moves = 0
        for i in range(2, 2 * limit + 1):
            current_moves += diff[i]
            ans = min(ans, current_moves)
            
        return ans
