class Solution(object):
    def shiftGrid(self, grid, k):
        m, n = len(grid), len(grid[0])
        total = m * n
        k = k % total
        
        result = [[0] * n for _ in range(m)]
        
        for r in range(m):
            for c in range(n):
                old_1d_idx = r * n + c
                new_1d_idx = (old_1d_idx + k) % total
                
                new_r = new_1d_idx // n
                new_c = new_1d_idx % n
                
                result[new_r][new_c] = grid[r][c]
                
        return result
        
