class Solution(object):
    def findMaxPathScore(self, edges, online, k):
        n = len(online)
        adj = [[] for _ in range(n)]
        in_degree = [0] * n
        
        for u, v, cost in edges:
            adj[u].append((v, cost))
            in_degree[v] += 1

        topo_order = []
        queue = [i for i in range(n) if in_degree[i] == 0]
        
        while queue:
            u = queue.pop(0) 
            topo_order.append(u)
            for v, _ in adj[u]:
                in_degree[v] -= 1
                if in_degree[v] == 0:
                    queue.append(v)          
        def check(mid):
            dp = [float('inf')] * n
            dp[0] = 0
            
            for u in topo_order:
                if dp[u] == float('inf') or not online[u]:
                    continue
                
                for v, cost in adj[u]:
                    if online[v] and cost >= mid:
                        if dp[u] + cost < dp[v]:
                            dp[v] = dp[u] + cost
            
            return dp[n - 1] <= k
        low = 0
        high = max([cost for _, _, cost in edges]) if edges else 0
        ans = -1
        
        while low <= high:
            mid = (low + high) // 2
            if check(mid):
                ans = mid       
                low = mid + 1
            else:
                high = mid - 1  
        return ans
